generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetClass {
  FIXED_INCOME
  BR_STOCK
  BR_FII
  US_STOCK
  US_REIT
  EMERGENCY_RESERVE
}

enum Currency {
  BRL
  USD
}

enum PriceMode {
  AUTO_YAHOO
  MANUAL
}

enum TransactionType {
  BUY
  SELL
  BALANCE_ADJUSTMENT
}

enum AuditEntityType {
  ASSET
  TRANSACTION
  GOAL
  SECTOR_GOAL
  SAVINGS_GOAL
  SAVINGS_MOVEMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  REVERT
}

enum SavingsMovementType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_OUT
  TRANSFER_IN
  YIELD_ADJUSTMENT
}

enum MonthlyExpenseCategory {
  BILL
  VARIABLE
  INVESTMENT
  TAX
}

enum MonthlyAllocationKind {
  LONG_TERM_DEPOSIT
  SAVINGS_DEPOSIT
  SAVINGS_WITHDRAWAL
}

enum FixedIncomeIndex {
  CDI_PCT
  CDI_PLUS
  SELIC_PCT
  SELIC_PLUS
  IPCA_PLUS
  PREFIXED
}

enum TickerValidationStatus {
  VERIFIED
  PENDING
  INVALID
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String?
  image                  String?
  appLockEnabled         Boolean                 @default(false)
  appLockPinHash         String?
  appLockTimeoutMinutes  Int                     @default(30)
  appLockRequirePinOnly  Boolean                 @default(false)
  appLockFailedAttempts  Int                     @default(0)
  appLockLockedUntil     DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  goal                   AllocationGoal?
  sectorGoals            SectorGoal[]
  assets                 Asset[]
  transactions           Transaction[]
  auditEvents            AuditEvent[]
  webAuthnCredentials    WebAuthnCredential[]
  securityChallenges     SecurityChallenge[]
  savingsGoals           SavingsGoal[]
  savingsVehicles        SavingsVehicle[]
  savingsMovements       SavingsMovement[]
  emergencyReserveConfig EmergencyReserveConfig?
  monthlyBudgets         MonthlyBudget[]
  monthlyIncomes         MonthlyIncome[]
  monthlyExpenses        MonthlyExpense[]
  monthlyAllocations     MonthlyAllocation[]
}

model AllocationGoal {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixedIncomePct    Decimal  @default(10) @db.Decimal(6, 2)
  variableIncomePct Decimal  @default(90) @db.Decimal(6, 2)
  brazilPct         Decimal  @default(60) @db.Decimal(6, 2)
  usaPct            Decimal  @default(40) @db.Decimal(6, 2)
  brStocksPct       Decimal  @default(70) @db.Decimal(6, 2)
  brFiisPct         Decimal  @default(30) @db.Decimal(6, 2)
  usStocksPct       Decimal  @default(70) @db.Decimal(6, 2)
  usReitsPct        Decimal  @default(30) @db.Decimal(6, 2)
  updatedAt         DateTime @updatedAt
}

model SectorGoal {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetClass AssetClass
  name       String
  targetPct  Decimal    @default(0) @db.Decimal(6, 2)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, assetClass, name])
  @@index([userId, assetClass])
}

model Asset {
  id                     String                 @id @default(cuid())
  userId                 String
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker                 String
  assetClass             AssetClass
  sector                 String                 @default("Outros")
  currency               Currency               @default(BRL)
  targetPctInClass       Decimal                @default(0) @db.Decimal(6, 2)
  priceMode              PriceMode              @default(AUTO_YAHOO)
  manualPrice            Decimal?               @db.Decimal(18, 6)
  isActive               Boolean                @default(true)
  tickerValidationStatus TickerValidationStatus @default(VERIFIED)
  fixedIncomeIndex       FixedIncomeIndex?
  fixedIncomeRate        Decimal?               @db.Decimal(8, 4)
  maturityDate           DateTime?
  taxExempt              Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  transactions           Transaction[]

  @@unique([userId, ticker])
  @@index([userId, assetClass])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date            DateTime
  type            TransactionType @default(BUY)
  quantity        Decimal         @db.Decimal(18, 8)
  unitPrice       Decimal         @db.Decimal(18, 6)
  totalAmount     Decimal         @db.Decimal(18, 4)
  fixedIncomeRate Decimal?        @db.Decimal(8, 4)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, date])
  @@index([assetId, date])
}

model QuoteCache {
  symbol    String   @id
  price     Decimal  @db.Decimal(18, 6)
  currency  String   @default("BRL")
  updatedAt DateTime @updatedAt
}

model HistoricalQuoteCache {
  symbol     String
  date       String   // Formato "YYYY-MM-DD"
  closePrice Decimal  @db.Decimal(18, 6)
  currency   String   @default("BRL")
  updatedAt  DateTime @updatedAt

  @@id([symbol, date])
  @@index([date])
}

model HistoricalQuoteSync {
  symbol      String   @id
  coveredFrom String   // Formato "YYYY-MM-DD"
  coveredTo   String   // Formato "YYYY-MM-DD"
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType     AuditEntityType
  entityId       String
  entityLabel    String
  action         AuditAction
  beforeState    Json?
  afterState     Json?
  revertsEventId String?
  revertsEvent   AuditEvent?     @relation("EventReversion", fields: [revertsEventId], references: [id], onDelete: SetNull)
  revertedBy     AuditEvent[]    @relation("EventReversion")
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([userId, entityType, entityId, createdAt])
  @@index([revertsEventId])
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String?
  deviceName   String
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model SecurityChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
}

model SavingsGoal {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  targetAmount       Decimal?            @db.Decimal(18, 2)
  targetDate         DateTime?
  isEmergencyReserve Boolean             @default(false)
  isClosed           Boolean             @default(false)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  movements          SavingsMovement[]
  monthlyAllocations MonthlyAllocation[]

  @@unique([userId, name])
  @@index([userId, isClosed, sortOrder])
}

model SavingsVehicle {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  institution String?
  isArchived  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  movements   SavingsMovement[]

  @@unique([userId, name])
  @@index([userId, isArchived])
}

model SavingsMovement {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId          String
  goal            SavingsGoal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         SavingsVehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date            DateTime
  type            SavingsMovementType
  signedAmount    Decimal             @db.Decimal(18, 2)
  transferGroupId String?
  externalKey     String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([userId, externalKey])
  @@index([userId, date])
  @@index([goalId, date])
  @@index([vehicleId])
  @@index([transferGroupId])
}

model EmergencyReserveConfig {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyExpense Decimal  @default(0) @db.Decimal(18, 2)
  scenariosJson  Json
  updatedAt      DateTime @updatedAt
}

model MonthlyBudget {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  checkingBalance Decimal             @default(0) @db.Decimal(18, 2)
  reportDate      DateTime            @default(now())
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  incomes         MonthlyIncome[]
  expenses        MonthlyExpense[]
  allocations     MonthlyAllocation[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model MonthlyIncome {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetId    String
  budget      MonthlyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name        String
  amount      Decimal       @db.Decimal(18, 2)
  isReceived  Boolean       @default(false)
  isRecurring Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([budgetId, sortOrder])
  @@index([userId])
}

model MonthlyExpense {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetId     String
  budget       MonthlyBudget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name         String
  category     MonthlyExpenseCategory @default(BILL)
  amount       Decimal                @db.Decimal(18, 2)
  isUnexpected Boolean                @default(false)
  isPaid       Boolean                @default(false)
  isRecurring  Boolean                @default(true)
  sortOrder    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([budgetId, isUnexpected, sortOrder])
  @@index([userId])
}

model MonthlyAllocation {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetId         String
  budget           MonthlyBudget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  kind             MonthlyAllocationKind
  name             String
  savingsGoalId    String?
  savingsGoal      SavingsGoal?          @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)
  amount           Decimal               @db.Decimal(18, 2)
  isExecuted       Boolean               @default(false)
  linkedMovementId String?
  isRecurring      Boolean               @default(true)
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([budgetId, kind, sortOrder])
  @@index([userId])
  @@index([savingsGoalId])
}

